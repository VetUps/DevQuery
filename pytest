#!/usr/bin/env bash
# Compatibility shim for agent verification environments that invoke bare `pytest` from POSIX shells.
# This project uses Django's test runner rather than pytest.
# Agent/local verification runs outside Docker Compose, so use a disposable SQLite test DB
# instead of the Compose-only MySQL host from .env (DATABASE_HOST=db).
set -euo pipefail

export DJANGO_TEST_SQLITE=1
export PYTHONPATH="src/backend${PYTHONPATH:+:$PYTHONPATH}"

python_exe="src/backend/venv/bin/python"
if [[ ! -x "$python_exe" ]]; then
  python_exe="python3"
fi

if [[ $# -gt 0 ]]; then
  translated_args=()
  for arg in "$@"; do
    case "$arg" in
      src/backend/*.py)
        module_path="${arg#src/backend/}"
        module_path="${module_path%.py}"
        translated_args+=("${module_path//\//.}")
        ;;
      *)
        translated_args+=("$arg")
        ;;
    esac
  done
  exec "$python_exe" src/backend/manage.py test "${translated_args[@]}"
fi

exec "$python_exe" src/backend/manage.py test apps.qa apps.user
