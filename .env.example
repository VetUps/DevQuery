# Django
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=*

# Database
DATABASE_NAME=stackoverflow_db
DATABASE_USER=stackoverflow_user
DATABASE_USER_PASSWORD=user_password
DATABASE_ROOT_PASSWORD=root_password
DATABASE_HOST=db
DATABASE_PORT=3306
DATABASE_EXTERNAL_PORT=3307
MYSQL_DATABASE=stackoverflow_db
MYSQL_USER=stackoverflow_user
MYSQL_PASSWORD=user_password
MYSQL_ROOT_PASSWORD=root_password

# Backend
BACKEND_PORT=8000

# M016 semantic knowledge graph AI providers
# Disabled/dry-run by default; production rebuilds require real secret values supplied outside source control.
KNOWLEDGE_GRAPH_AI_ENABLED=False
KNOWLEDGE_GRAPH_AI_DRY_RUN=True
KNOWLEDGE_GRAPH_REBUILD_BUDGET_CAP=0
KNOWLEDGE_GRAPH_REBUILD_RATE_LIMIT=3/hour

# Embeddings: production provider is GigaChat; use `fake` only for explicit local/test mode.
KNOWLEDGE_GRAPH_EMBEDDING_PROVIDER=gigachat
KNOWLEDGE_GRAPH_EMBEDDING_API_KEY=
KNOWLEDGE_GRAPH_EMBEDDING_BASE_URL=https://gigachat.devices.sberbank.ru/api/v1
KNOWLEDGE_GRAPH_EMBEDDING_MODEL=Embeddings
KNOWLEDGE_GRAPH_EMBEDDING_DIMENSIONS=1024
KNOWLEDGE_GRAPH_EMBEDDING_TIMEOUT_SECONDS=10
KNOWLEDGE_GRAPH_EMBEDDING_PRICE_PER_1K_TOKENS=0
KNOWLEDGE_GRAPH_GIGACHAT_SCOPE=GIGACHAT_API_PERS
KNOWLEDGE_GRAPH_GIGACHAT_AUTH_URL=
KNOWLEDGE_GRAPH_GIGACHAT_VERIFY_SSL_CERTS=True
KNOWLEDGE_GRAPH_GIGACHAT_CA_BUNDLE_FILE=
KNOWLEDGE_GRAPH_GIGACHAT_MAX_RETRIES=0

# Grouping/chat: production provider is DeepSeek OpenAI-compatible chat completions.
KNOWLEDGE_GRAPH_CHAT_PROVIDER=deepseek
KNOWLEDGE_GRAPH_CHAT_API_KEY=
KNOWLEDGE_GRAPH_CHAT_BASE_URL=https://api.deepseek.com
KNOWLEDGE_GRAPH_CHAT_MODEL=deepseek-v4-flash
KNOWLEDGE_GRAPH_CHAT_TIMEOUT_SECONDS=20
KNOWLEDGE_GRAPH_CHAT_PRICE_PER_1K_TOKENS=0
