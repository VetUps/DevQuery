# Docker images
BACKEND_IMAGE=example/devquery-backend:sha-example
FRONTEND_IMAGE=example/devquery-frontend:sha-example

# Public URLs
PUBLIC_FRONTEND_URL=http://<VPS_IP>
PUBLIC_BACKEND_URL=http://<VPS_IP>:8000

# Django
SECRET_KEY=replace-with-production-secret-key
DEBUG=False
ALLOWED_HOSTS=<VPS_IP>,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://<VPS_IP>

# Database connection used by Django
DATABASE_NAME=devquery
DATABASE_USER=devquery
DATABASE_USER_PASSWORD=replace-with-database-password
DATABASE_HOST=db
DATABASE_PORT=3306

# MySQL container initialization
MYSQL_DATABASE=devquery
MYSQL_USER=devquery
MYSQL_PASSWORD=replace-with-database-password
MYSQL_ROOT_PASSWORD=replace-with-root-password

# Published ports
BACKEND_PORT=8000
FRONTEND_PORT=80
